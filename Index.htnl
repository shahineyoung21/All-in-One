<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>All-in-One | بوابة الإعدادي</title>
<meta name="description" content="منصة تعليمية للمرحلة الإعدادية المصرية: مناهج، دروس، اختبارات، مترجم ومتابعة تقدم.">
<style>
:root{--ink:#19213d;--muted:#6e7895;--bg:#f4f7ff;--card:#fff;--line:#e7eaf4;--p:#4f46e5;--p2:#7c3aed;--green:#10b981;--orange:#f59e0b;--red:#ef4444;--shadow:0 18px 45px rgba(34,48,90,.1)}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(circle at 15% 0,#ece9ff 0 14%,transparent 32%),linear-gradient(180deg,#fbfcff,#eef2fa 65%,#f8f9fd);font-family:Tahoma,"Segoe UI",Arial,sans-serif;color:var(--ink)}button,input,select,textarea{font:inherit}button{cursor:pointer}a{text-decoration:none;color:inherit}.app{max-width:1240px;margin:auto;padding:18px}
.topbar{display:flex;align-items:center;justify-content:space-between;gap:14px;background:#fff;border:1px solid var(--line);border-radius:20px;padding:12px 16px;box-shadow:var(--shadow);position:sticky;top:12px;z-index:20}.brand-mini{display:flex;align-items:center;gap:10px;font-weight:900}.brand-icon{width:42px;height:42px;border-radius:14px;display:grid;place-items:center;color:#fff;background:linear-gradient(135deg,var(--p),var(--p2));font-size:21px}.actions{display:flex;gap:8px;align-items:center}.iconbtn{border:0;background:#f1f3fb;color:var(--ink);border-radius:12px;padding:10px 12px}.primary{border:0;border-radius:12px;padding:11px 16px;background:linear-gradient(135deg,var(--p),var(--p2));color:#fff;font-weight:900}.ghost{border:1px solid var(--line);border-radius:12px;padding:10px 14px;background:#fff;color:var(--ink);font-weight:800}.speak{border:0;border-radius:12px;padding:10px 14px;background:#eafaf4;color:#08734d;font-weight:900}.speak:disabled{opacity:.45;cursor:not-allowed}.dark .speak{background:#193d39;color:#9ef0ce}.search{width:250px;max-width:100%;border:1px solid var(--line);background:#fff;border-radius:12px;padding:10px 13px;outline:0}.search:focus,.field select:focus,.field textarea:focus{border-color:var(--p);box-shadow:0 0 0 3px #4f46e51a}.empty{grid-column:1/-1;text-align:center;padding:28px;color:var(--muted);border:1px dashed var(--line);border-radius:16px}.toast{position:fixed;bottom:20px;left:20px;z-index:100;background:#17213d;color:#fff;padding:12px 16px;border-radius:13px;box-shadow:var(--shadow);display:none}.dark{--ink:#edf0ff;--muted:#aab2d0;--bg:#11152a;--card:#1b2140;--line:#303858;--shadow:0 18px 45px rgba(0,0,0,.28)}.dark body{background:linear-gradient(180deg,#11152a,#171d36)}.dark .topbar,.dark .grade-section,.dark .panel,.dark .subject,.dark .exam-card,.dark .resource,.dark .sheet,.dark .grade{background:#1b2140}.dark .iconbtn,.dark .pill,.dark .unit-btn,.dark .lesson-card,.dark .exam-tab,.dark .choice,.dark .search,.dark .ghost,.dark .field select,.dark .field textarea,.dark .field input{background:#242c4d;color:var(--ink);border-color:var(--line)}.dark .stat{background:#202846}.dark .topbar{background:#1b2140}
.hero{margin-top:18px;overflow:hidden;border-radius:30px;background:linear-gradient(135deg,#211a5b 0%,#4f46e5 56%,#8b5cf6 100%);color:#fff;box-shadow:var(--shadow);padding:34px;position:relative}.hero:before,.hero:after{content:"";position:absolute;border-radius:50%;background:#ffffff13}.hero:before{width:260px;height:260px;left:-80px;top:-110px}.hero:after{width:180px;height:180px;right:-45px;bottom:-80px}.hero-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:20px;position:relative;z-index:1;align-items:center}.hero h1{font-size:42px;line-height:1.18;margin:9px 0}.hero h1 span{color:#ddd8ff}.hero p{max-width:720px;color:#edeaff;line-height:1.85}.kicker{display:inline-flex;gap:8px;align-items:center;background:#ffffff19;border:1px solid #ffffff26;padding:8px 12px;border-radius:99px;font-size:13px;font-weight:800}.hero-visual{display:grid;place-items:center}.books-art{width:min(100%,390px);filter:drop-shadow(0 18px 25px #17134b44)}
.grade-section{margin-top:20px;background:rgba(255,255,255,.7);border:1px solid var(--line);backdrop-filter:blur(10px);border-radius:24px;padding:18px}.section-head{display:flex;justify-content:space-between;align-items:center;gap:14px;margin-bottom:14px}.section-head h2,.section-head h3{margin:0}.section-head p{margin:3px 0 0;color:var(--muted);font-size:12px}.grades{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.grade{padding:18px;border-radius:20px;border:2px solid transparent;background:#fff;text-align:right;box-shadow:0 10px 25px rgba(35,40,75,.06);transition:.2s}.grade:hover{transform:translateY(-2px)}.grade.active{border-color:var(--p);background:#f2f1ff}.grade-icon{font-size:30px}.grade b{display:block;font-size:18px;margin-top:7px}.grade small{color:var(--muted)}
.content{margin-top:20px}.controls{display:flex;gap:8px;flex-wrap:wrap}.pill{border:1px solid var(--line);background:#fff;padding:9px 13px;border-radius:99px}.pill.active{background:#efefff;color:#3d34bb;border-color:#c7c4ff}.subjects{display:grid;grid-template-columns:repeat(5,1fr);gap:13px}.subject{background:#fff;border:1px solid var(--line);border-radius:20px;padding:16px;box-shadow:var(--shadow);min-height:180px;display:flex;flex-direction:column;justify-content:space-between;position:relative;overflow:hidden}.subject:after{content:"";position:absolute;left:-35px;bottom:-55px;width:110px;height:110px;border-radius:50%;background:var(--tint,#eef2ff)}.subject-top{position:relative;z-index:1}.sub-icon{font-size:34px}.subject h3{margin:7px 0 4px;font-size:17px}.subject p{margin:0;color:var(--muted);font-size:12px;line-height:1.6}.subject button{position:relative;z-index:1;margin-top:12px;width:100%;padding:10px;border-radius:12px;border:0;background:var(--tint,#eef2ff);color:var(--accent,var(--p));font-weight:900}
.main-grid{display:grid;grid-template-columns:1.4fr .6fr;gap:15px;margin-top:16px}.panel{background:#fff;border:1px solid var(--line);border-radius:22px;padding:18px;box-shadow:var(--shadow)}.crumb{font-size:12px;color:var(--muted);margin-bottom:8px}.curriculum{display:grid;grid-template-columns:300px 1fr;gap:14px}.units{display:flex;flex-direction:column;gap:8px}.unit-btn{background:#f7f8fc;border:1px solid var(--line);padding:12px;border-radius:14px;text-align:right}.unit-btn.active{background:#efefff;border-color:#c8c4ff;color:#3930b7}.lesson-list{display:grid;gap:10px}.lesson-card{display:flex;gap:12px;align-items:center;border:1px solid var(--line);padding:13px;border-radius:16px}.lesson-num{width:36px;height:36px;border-radius:11px;background:#eef0ff;color:#3d35c1;display:grid;place-items:center;font-weight:900;flex:0 0 auto}.lesson-card strong{display:block}.lesson-card small{color:var(--muted)}.lesson-card .go{margin-right:auto;border:0;border-radius:11px;background:#f1f3f9;padding:9px 11px}.stats{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.stat{background:#f8f9fd;border:1px solid var(--line);padding:14px;border-radius:15px}.stat small{color:var(--muted)}.stat b{display:block;font-size:25px;margin-top:3px}.progress{height:9px;background:#e9ebf2;border-radius:99px;overflow:hidden}.bar{height:100%;background:linear-gradient(90deg,var(--p),#8b5cf6);border-radius:99px}
.exam-tabs{display:flex;gap:8px;overflow:auto}.exam-tab{white-space:nowrap;border:0;background:#f1f2f7;border-radius:12px;padding:10px 13px}.exam-tab.active{background:var(--p);color:#fff}.exam-cards{display:grid;grid-template-columns:repeat(5,1fr);gap:9px;margin-top:14px}.exam-card{border:1px solid var(--line);background:#fff;border-radius:16px;padding:12px;text-align:right}.exam-card b{display:block;margin:5px 0}.exam-card small{color:var(--muted)}.exam-card button{margin-top:9px;width:100%;padding:9px;border:0;border-radius:11px;background:#f0efff;color:#3e37ba;font-weight:800}
.translate-grid{display:grid;grid-template-columns:1fr auto 1fr;gap:9px;align-items:end}.field label{display:block;font-size:12px;color:var(--muted);margin-bottom:5px}.field select,.field textarea,.field input{width:100%;border:1px solid var(--line);background:#fbfcff;border-radius:13px;padding:11px;outline:0}.swap{width:44px;height:44px;border-radius:13px;background:#efefff;color:#3e37bb;font-size:20px}.result{margin-top:12px;padding:13px;border-radius:14px;background:#f0fdf6;border:1px solid #c5eedc;color:#0c6b46;display:none}.history{margin-top:10px;display:flex;gap:7px;flex-wrap:wrap}.history button{background:#f2f3f8;border:0;border-radius:99px;padding:8px 10px;font-size:12px}
.resource-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.resource{padding:15px;border:1px solid var(--line);border-radius:16px;background:linear-gradient(180deg,#fff,#fafaff)}.resource .tag{display:inline-block;padding:5px 8px;border-radius:9px;background:#f2f1ff;color:#493fc7;font-size:11px}.resource h4{margin:8px 0 4px}.resource p{font-size:12px;color:var(--muted);line-height:1.6}.resource button{padding:9px 12px;border:0;border-radius:11px;background:#17213d;color:#fff}.premium{background:linear-gradient(135deg,#1e174d,#4126a8);color:#fff;overflow:hidden;position:relative}.premium:after{content:"👑";position:absolute;font-size:120px;left:18px;bottom:-25px;opacity:.1}.premium p{color:#dfdcff}.premium button{background:#fff;color:#3d30a0}.footer{padding:28px 5px;text-align:center;color:var(--muted);font-size:12px}
.payment-option{display:flex;align-items:center;gap:10px;border:1px solid var(--line);padding:13px;border-radius:14px;background:#fafaff;cursor:pointer}.payment-option:has(input:checked){border-color:var(--p);background:#efefff}.payment-option input{accent-color:var(--p)}.payment-note{font-size:12px;color:var(--muted);line-height:1.7}.modal{position:fixed;inset:0;background:#0f153099;display:none;align-items:flex-end;justify-content:center;padding:10px;z-index:50}.modal.show{display:flex}.sheet{width:min(900px,100%);max-height:93vh;overflow:auto;background:#fff;border-radius:28px;padding:20px}.sheet-head{display:flex;justify-content:space-between;align-items:center}.close{border:0;background:#f1f2f7;border-radius:11px;padding:9px 12px}.article h2{margin:0}.article p,.article li{line-height:1.9}.callout{background:#f7f8ff;border:1px solid #dfe2ff;border-radius:16px;padding:14px;margin:12px 0}.q{font-size:20px;font-weight:900;line-height:1.8;margin-top:14px}.choice{display:block;width:100%;text-align:right;padding:12px;border:2px solid #eceef5;background:#f8f9fc;border-radius:13px;margin-top:9px}.choice.sel{border-color:var(--p);background:#efefff}.timer{background:#fff7ed;color:#9a3412;padding:8px 11px;border-radius:99px;font-weight:900}.score{font-size:62px;color:var(--p);font-weight:900;text-align:center}.small{font-size:12px;color:var(--muted)}
@media(max-width:1000px){.subjects{grid-template-columns:repeat(3,1fr)}.exam-cards{grid-template-columns:repeat(3,1fr)}.resource-grid{grid-template-columns:repeat(2,1fr)}.main-grid{grid-template-columns:1fr}.curriculum{grid-template-columns:1fr}}@media(max-width:700px){.app{padding:11px}.hero{padding:23px}.hero-grid{grid-template-columns:1fr}.hero h1{font-size:30px}.hero-visual{display:none}.grades{grid-template-columns:1fr}.subjects{grid-template-columns:repeat(2,1fr)}.feature-grid{grid-template-columns:1fr}.translate-grid{grid-template-columns:1fr}.swap{width:100%;height:40px}.exam-cards{grid-template-columns:repeat(2,1fr)}}@media(max-width:470px){.subjects{grid-template-columns:1fr}.resource-grid{grid-template-columns:1fr}.exam-cards{grid-template-columns:1fr}.topbar{position:static}.brand-mini span{display:none}}
</style></head>
<body><div class="app">
<header class="topbar"><div class="brand-mini"><div class="brand-icon">🎓</div><span>All‑in‑One التعليمية</span></div><div class="actions"><button class="iconbtn" onclick="scrollToId('translator')">🌐 المترجم</button><button class="iconbtn" onclick="scrollToId('exams')">📝 الاختبارات</button><button class="iconbtn" onclick="scrollToId('premium')">👑 المميز</button><button class="iconbtn" id="themeBtn" onclick="toggleTheme()" aria-label="تبديل الوضع">🌙</button><button class="iconbtn" onclick="resetProgress()">↺ تصفير التقدم</button></div></header>
<section class="hero"><div class="hero-grid"><div><span class="kicker">🇪🇬 المرحلة الإعدادية المصرية • 2025 / 2026</span><h1>ذاكر بذكاء، <span>افهم أكتر،</span> وادخل الامتحان جاهز 🚀</h1><p>منصة واحدة للثلاث مراحل: خريطة منهج، شرح وتدريب، اختبارات شهرية وتجريبية، متابعة تقدم، مترجم متعدد اللغات، ومكتبة مراجع إضافية.</p><div class="controls"><button class="pill active" onclick="scrollToId('grades')">ابدأ باختيار صفك</button><button class="pill" onclick="scrollToId('resources')">مكتبة المراجع</button></div></div><div class="hero-visual"><svg class="books-art" viewBox="0 0 420 290"><defs><linearGradient id="g1"><stop stop-color="#fff"/><stop offset="1" stop-color="#ddd8ff"/></linearGradient><linearGradient id="g2"><stop stop-color="#22d3ee"/><stop offset="1" stop-color="#818cf8"/></linearGradient></defs><rect x="55" y="140" width="260" height="62" rx="15" fill="#fff" opacity=".95" transform="rotate(-5 55 140)"/><rect x="100" y="115" width="240" height="58" rx="15" fill="url(#g1)" transform="rotate(7 100 115)"/><rect x="142" y="87" width="190" height="52" rx="14" fill="url(#g2)" transform="rotate(-3 142 87)"/><circle cx="340" cy="72" r="42" fill="#fff" opacity=".9"/><text x="340" y="83" text-anchor="middle" font-size="40">💡</text><text x="187" y="175" text-anchor="middle" fill="#4f46e5" font-size="21" font-weight="700">تعلم • اختبر • تقدّم</text></svg></div></div></section>
<section id="grades" class="grade-section"><div class="section-head"><div><h2>اختار الصف 👋</h2><p>كل صف له مواده واختباراته بشكل مستقل.</p></div><span class="pill active" id="selectedGrade">أولى إعدادي</span></div><div class="grades" id="gradeCards"></div></section>
<main class="content"><section><div class="section-head"><div><h2>📚 المواد الأساسية</h2><p>اضغط مادة واحدة لفتح منهجها الخاص.</p></div><span class="small" id="termLabel">الترم الأول</span></div><div class="controls" style="margin-bottom:12px"><input class="search" id="subjectSearch" oninput="renderSubjects()" placeholder="ابحث عن مادة..." aria-label="البحث عن مادة"><button class="pill active" id="term1" onclick="setTerm(1)">الترم الأول</button><button class="pill" id="term2" onclick="setTerm(2)">الترم الثاني</button></div><div class="subjects" id="subjectCards"></div></section>
<section class="main-grid"><div class="panel"><div class="crumb" id="crumb">المنهج</div><div class="section-head"><div><h2 id="currTitle">اختر مادة</h2><p id="currSubtitle">ستظهر الوحدات والدروس هنا.</p></div><span class="pill" id="unitCount">0 وحدة</span></div><div class="curriculum"><div class="units" id="units"></div><div><div class="lesson-list" id="lessonList"><div class="callout">اختار مادة من الأعلى، وستظهر الوحدات ثم الدروس.</div></div></div></div></div>
<aside class="panel"><div class="section-head"><div><h3>📊 تقدمي الحقيقي</h3><p>لا توجد أرقام وهمية.</p></div></div><div class="stats"><div class="stat"><small>متوسط الاختبارات</small><b id="avgScore">0%</b></div><div class="stat"><small>اختبارات منجزة</small><b id="attempts">0</b></div><div class="stat"><small>دروس مكتملة</small><b id="lessonsDone">0</b></div><div class="stat"><small>أعلى مادة</small><b id="bestSubject">—</b></div></div><div style="margin-top:16px"><small class="small">تقدم الصف الحالي</small><div class="progress" style="margin-top:7px"><div class="bar" id="gradeProgress" style="width:0%"></div></div></div><div class="callout" style="margin-top:15px">💡 كل نسبة هنا تُحسب من الاختبارات والدروس التي نفذها الطالب فعلًا.</div></aside></section>
<section id="exams" class="panel" style="margin-top:16px"><div class="section-head"><div><h2>📝 مركز الاختبارات</h2><p>اختبارات شهرية + منتصف العام + نهاية العام التجريبية.</p></div><span class="pill active" id="examGrade"></span></div><div class="exam-tabs" id="examTabs"></div><div class="exam-cards" id="examCards"></div></section>
<section id="translator" class="panel" style="margin-top:16px"><div class="section-head"><div><h2>🌐 المترجم الذكي</h2><p>سبع لغات مع تبديل سريع بين اتجاهي الترجمة.</p></div><span class="pill">العربية • English • Français • Deutsch • Español • Italiano • Русский</span></div><div class="translate-grid"><div class="field"><label>من</label><select id="fromLang"></select><textarea id="fromText" rows="5" placeholder="اكتب النص هنا..."></textarea></div><button class="swap" onclick="swapLangs()">⇄</button><div class="field"><label>إلى</label><select id="toLang"></select><textarea id="toText" rows="5" placeholder="الترجمة ستظهر هنا..." readonly></textarea></div></div><div class="controls" style="margin-top:10px"><button class="primary" onclick="translateNow()">ترجم الآن</button><button class="speak" id="speakBtn" onclick="speakTranslation()" disabled>🔊 سماع الترجمة</button><button class="ghost" id="stopSpeakBtn" onclick="stopSpeaking()" disabled>⏹ إيقاف</button><button class="ghost" onclick="clearTranslator()">مسح</button></div><div class="result" id="translationResult"></div><div class="history" id="translationHistory"></div></section>
<section id="resources" class="section"><div class="section-head"><div><h2>📚 مكتبة المراجع</h2><p>نميز بوضوح بين المصدر الرسمي والمراجع التجارية/الخارجية.</p></div></div><div class="resource-grid"><div class="resource"><span class="tag">رسمي</span><h4>📘 كتب وزارة التربية والتعليم</h4><p>مصدر الكتب والمواد التعليمية المتاحة رسميًا.</p><a href="https://moe.gov.eg/ar/elearningenterypage/e-learning/" target="_blank"><button>فتح المصدر الرسمي</button></a></div><div class="resource"><span class="tag">مرجع إضافي</span><h4>📗 الأضواء</h4><p>نضيف رابطًا رسميًا/قانونيًا أو خدمة مرخصة، بدون نسخ صفحات الكتاب المحمية.</p><button onclick="notice('الأضواء: سنربطه بالناشر/المتجر الرسمي عند تجهيز الإطلاق.')">التفاصيل</button></div><div class="resource"><span class="tag">مرجع إضافي</span><h4>📙 كتاب الامتحان</h4><p>مراجع تدريبية إضافية؛ لا ننشر المحتوى المحمي كاملًا من غير إذن.</p><button onclick="notice('كتاب الامتحان: قسم المراجع جاهز للربط القانوني.')">التفاصيل</button></div><div class="resource"><span class="tag">مرجع إضافي</span><h4>📕 سلاح التلميذ</h4><p>يمكن ربط الكتاب بمصدره الرسمي/المتجر بدل نسخه داخل الموقع.</p><button onclick="notice('سلاح التلميذ: جاهز للربط بمصدر الشراء/الناشر الرسمي.')">التفاصيل</button></div></div></section>
<section id="premium" class="panel premium" style="margin-top:16px"><div style="position:relative;z-index:1"><span class="kicker">👑 خدمات إضافية</span><h2 style="font-size:28px;margin:10px 0 5px">خلّي المنصة أذكى للطالب</h2><p>بنك أسئلة موسع، اختبارات إضافية، تحليل متقدم، وخطط مراجعة. الدفع الحقيقي سيُربط بمزود رسمي وبعد تأكيد المعاملة فقط.</p><button class="primary" onclick="openPaymentModal()">اشترك بأمان</button></div></section></main>
<div class="toast" id="toast" role="status"></div><div class="footer">All‑in‑One • Prototype متقدم. المحتوى الرسمي الكامل يُراجع مقابل المصادر الرسمية قبل إطلاقه للطلاب.</div></div>
<div class="modal" id="paymentModal"><div class="sheet"><div class="sheet-head"><div><div class="small">اشتراك الطالب</div><h2>اختر وسيلة الدفع</h2></div><button class="close" onclick="closeModal('paymentModal')">إغلاق</button></div><p class="payment-note">اختر محفظتك المفضلة. لن يتم فتح أي محتوى مدفوع إلا بعد تأكيد العملية من بوابة الدفع الرسمية.</p><div style="display:grid;gap:9px;margin:15px 0"><label class="payment-option"><input type="radio" name="paymentMethod" value="vodafone" checked><span>📱 <b>Vodafone Cash</b><small class="small"> دفع عبر بوابة رسمية</small></span></label><label class="payment-option"><input type="radio" name="paymentMethod" value="etisalat"><span>📱 <b>Etisalat Cash</b><small class="small"> دفع عبر بوابة رسمية</small></span></label></div><div class="callout">🔒 حالة الربط: <b>بانتظار تفعيل بوابة الدفع</b><br><span class="payment-note">لن نطلب تحويلًا يدويًا، ولن نعتمد على صورة إيصال. بعد إضافة بيانات مزود الدفع سيظهر زر الدفع الرسمي هنا.</span></div><button class="primary" style="width:100%" onclick="requestOfficialPayment()">متابعة إلى الدفع الرسمي</button><div id="paymentStatus" class="result" style="margin-top:10px"></div></div></div><div class="modal" id="lessonModal"><div class="sheet" id="lessonSheet"></div></div><div class="modal" id="quizModal"><div class="sheet" id="quizSheet"></div></div>
<script>
const LANGS=[{code:'ar',name:'العربية'},{code:'en',name:'English'},{code:'fr',name:'Français'},{code:'de',name:'Deutsch'},{code:'es',name:'Español'},{code:'it',name:'Italiano'},{code:'ru',name:'Русский'}];
const SUBJECTS=[{id:'ar',icon:'📘',name:'اللغة العربية',accent:'#5146e5',tint:'#efefff',desc:'قراءة • نصوص • نحو • كتابة'},{id:'en',icon:'🇬🇧',name:'اللغة الإنجليزية',accent:'#2563eb',tint:'#eaf2ff',desc:'Vocabulary • Grammar • Reading'},{id:'math',icon:'📐',name:'الرياضيات',accent:'#db2777',tint:'#fff0f7',desc:'جبر • هندسة • حساب • تطبيق'},{id:'science',icon:'🔬',name:'العلوم',accent:'#059669',tint:'#eafaf4',desc:'مادة • قوى • طاقة • حياة'},{id:'social',icon:'🌍',name:'الدراسات الاجتماعية',accent:'#b45309',tint:'#fff6df',desc:'جغرافيا • تاريخ • حضارة'}];
const GRADES=[{id:1,name:'أولى إعدادي',icon:'🌱',note:'بداية المرحلة الإعدادية'},{id:2,name:'ثانية إعدادي',icon:'🚀',note:'توسيع الفهم والمهارات'},{id:3,name:'ثالثة إعدادي',icon:'🎯',note:'الاستعداد للمرحلة التالية'}];
const BASE={
1:{ar:['أنا مصري','العلم والعمل','قيم وحياة'],en:['Personal & National Identity','School & Learning','Life & Values'],math:['الأعداد والعمليات','الجبر والمعادلات','الهندسة والقياس'],science:['المادة','مجالات القوى','الطاقة والأنظمة الحية'],social:['الملامح الطبيعية لقارة إفريقيا وحضاراتها القديمة','الحضارة المصرية القديمة وعلاقاتها بإفريقيا','النظم البيئية في إفريقيا']},
2:{ar:['قراءة ونصوص','القواعد والتطبيق','الكتابة والتواصل'],en:['Communication','Skills in Context','Reading & Writing'],math:['الجبر','الهندسة','الإحصاء والتطبيقات'],science:['الطاقة','المادة والتفاعلات','الأحياء والبيئة'],social:['جغرافيا المكان والموارد','تاريخ مصر والعالم العربي','المواطنة والمجتمع']},
3:{ar:['القراءة والتذوق','القواعد في السياق','الكتابة والتواصل'],en:['Language & Communication','Grammar in Context','Exam Skills'],math:['الجبر والمعادلات','الهندسة','الإحصاء والاحتمال'],science:['العلوم الفيزيائية','العلوم الكيميائية','الأحياء والبيئة'],social:['الجغرافيا','التاريخ','قضايا ومواطنة']}};
const DETAIL={ar:['نصوص وقراءة وفهم','قواعد نحوية في السياق','إملاء وعلامات ترقيم','تحدث واستماع','تعبير كتابي','تقييم قصير'],en:['Listening & speaking','Reading for meaning','Vocabulary in context','Grammar in context','Writing practice','Unit review'],math:['الأعداد والعمليات','التعبيرات الجبرية','المعادلات الخطية','المثلثات والزوايا','المحيط والمساحة','تدريبات الوحدة'],science:['تركيب الذرة','الجدول الدوري لتصنيف العناصر','المادة وخصائصها','الروابط الكيميائية','القوى الكهربائية','القوى المغناطيسية','قوى الجاذبية'],social:['موقع إفريقيا وحدودها','تضاريس إفريقيا','المناخ والموارد الطبيعية','حضارات إفريقية قديمة','نشأة الحضارة المصرية','إنجازات الحضارة','النظم البيئية والتنوع الحيوي']};
const EXTRA=['مفاهيم الدرس ومصطلحاته','شرح مبسط بالأمثلة','نشاط تطبيقي','أسئلة على الفهم','تدريب امتحاني','تقويم الدرس'];
const Q={ar:[['الفعل الذي يحتاج إلى مفعول به يسمى…',['لازم','متعدي','جامد','مبني للمجهول'],1],['علامات الترقيم تساعد على…',['تنظيم المعنى','حل المعادلات','قياس الزوايا','تغيير اللغة'],0],['القراءة الجيدة تبدأ بـ…',['فهم الفكرة العامة','حفظ كل كلمة','تجاهل العنوان','عدم قراءة السؤال'],0]],en:[['Choose the correct sentence.',['He goes to school.','He go to school.','He going school.','He gone school.'],0],['Opposite of difficult is…',['easy','early','empty','late'],0],['Book is a…',['noun','verb','adjective','preposition'],0]],math:[['إذا كان 3x = 18، فما قيمة x؟',['3','6','9','12'],1],['مجموع زوايا المثلث يساوي…',['90°','180°','270°','360°'],1],['إذا كانت a=5 وb=2، فما a+b؟',['2','3','7','10'],2]],science:[['أي مما يلي مصدر للطاقة؟',['الشمس','الزجاج','الورق','الملح'],0],['الجدول الدوري يُستخدم في تصنيف…',['العناصر','الكتب','القارات','الزوايا'],0],['من قوى الطبيعة الأساسية…',['الجاذبية','علامات الترقيم','القراءة','الإملاء'],0]],social:[['تقع مصر بين قارتي…',['أفريقيا وآسيا','أوروبا وأمريكا','آسيا وأستراليا','أفريقيا وأمريكا'],0],['دراسة سطح الأرض والسكان والموارد هي…',['الجغرافيا','النحو','الجبر','الكيمياء'],0],['دراسة الأحداث الماضية ترتبط بـ…',['التاريخ','الهندسة','الفيزياء','الإملاء'],0]]};
const EXTRA_Q={
ar:[['ما نوع كلمة «الطالب»؟',['اسم','فعل','حرف','ضمير'],0],['الجملة الاسمية تبدأ غالبًا بـ…',['فعل','اسم','حرف جر','أداة نفي'],1],['مرادف كلمة «سعيد» هو…',['حزين','فرحان','ضعيف','بعيد'],1],['علامة الاستفهام توضع في نهاية…',['السؤال','التعجب','النداء','الجملة الخبرية'],0],['جمع كلمة «كتاب» هو…',['كاتب','كتب','مكتبة','كتابان'],1],['في جملة «اجتهدْ تنجحْ» الأسلوب هو…',['نهي','أمر','تعجب','استفهام'],1],['الكلمة التي تدل على حدث مرتبط بزمن هي…',['الاسم','الفعل','الحرف','الصفة'],1],['الفاعل في «قرأَ أحمدُ الدرسَ» هو…',['قرأ','أحمد','الدرس','الجملة'],1],['التعبير الجيد يتصف بـ…',['الغموض','ترتيب الأفكار','تكرار الكلمات','إهمال علامات الترقيم'],1]],
en:[['Choose the correct plural.',['childs','children','childes','child'],1],['She ___ a book now.',['read','reads','is reading','reading'],2],['The opposite of “early” is…',['late','fast','small','near'],0],['We use “an” before…',['a consonant sound','a vowel sound','every verb','a plural noun'],1],['Ahmed is taller ___ Ali.',['then','than','that','to'],1],['Which word is a verb?',['beautiful','quickly','write','school'],2],['They ___ football yesterday.',['play','plays','played','playing'],2],['The capital of Egypt is…',['Alexandria','Giza','Cairo','Luxor'],2],['“Library” means a place where we…',['buy food','read books','play football','make clothes'],1]],
math:[['ناتج 7 + 8 يساوي…',['13','14','15','16'],2],['إذا كان x + 4 = 11 فإن x =…',['5','6','7','8'],2],['نصف العدد 18 يساوي…',['6','8','9','12'],2],['محيط مربع طول ضلعه 5 سم يساوي…',['10 سم','15 سم','20 سم','25 سم'],2],['العدد الأولي من الآتي هو…',['9','12','15','17'],3],['إذا كان 2a = 14 فإن a =…',['5','6','7','8'],2],['مساحة مستطيل طوله 6 وعرضه 3 تساوي…',['9','12','18','24'],2],['الزاوية القائمة قياسها…',['45°','90°','180°','360°'],1],['المتوسط الحسابي للعددين 4 و8 هو…',['4','6','8','12'],1]],
science:[['توجد المادة في حالات…',['حالتين','ثلاث حالات','أربع حالات','حالة واحدة'],1],['تحول الماء من سائل إلى غاز يسمى…',['تجمدًا','تبخرًا','تكاثفًا','انصهارًا'],1],['الوحدة الشائعة لقياس القوة هي…',['المتر','الكيلوجرام','النيوتن','اللتر'],2],['العضو المسؤول عن ضخ الدم هو…',['الرئة','القلب','المعدة','المخ'],1],['تحتاج النباتات لصنع غذائها إلى الضوء و…',['الأكسجين فقط','ثاني أكسيد الكربون','الملح','الحديد'],1],['المغناطيس يجذب المواد المصنوعة من…',['الخشب','الزجاج','الحديد','البلاستيك'],2],['المخلوط الذي يمكن فصل مكوناته بالترشيح هو…',['ماء وملح','رمل وماء','سكر وماء','هواء'],1],['مصدر الطاقة المتجددة هو…',['الفحم','البترول','الرياح','الغاز الطبيعي'],2],['السلسلة الغذائية تبدأ عادةً بـ…',['المحللات','المنتجات','المستهلكات','الحيوانات المفترسة'],1]],
social:[['أطول أنهار العالم ويمر بمصر هو…',['نهر النيل','نهر الأمازون','نهر دجلة','نهر الفرات'],0],['شبه جزيرة سيناء تقع في قارة…',['أوروبا','آسيا','أمريكا','أستراليا'],1],['من مصادر المياه العذبة…',['مياه البحار','الأنهار','المحيطات','المياه المالحة'],1],['عاصمة مصر هي…',['الإسكندرية','القاهرة','أسوان','بورسعيد'],1],['من أشهر إنجازات المصريين القدماء…',['الأهرامات','ناطحات السحاب','القطارات','الأقمار الصناعية'],0],['الخريطة تمثل سطح الأرض باستخدام…',['رموز ومقياس رسم','قصص فقط','ألوان عشوائية','صور بلا اتجاه'],0],['المناخ يصف حالة الجو خلال…',['ساعة واحدة','فترة طويلة','دقيقة','يوم واحد فقط'],1],['المواطن الصالح يحافظ على…',['الفوضى','البيئة والممتلكات العامة','الإشاعات','إهدار المياه'],1],['القارة التي تقع مصر في شمالها الشرقي هي…',['إفريقيا','أوروبا','أمريكا الجنوبية','أستراليا'],0]]};
function getQuizAttemptLevel(subjectId){return Math.min(2,attempts.filter(x=>x.grade===grade&&x.term===term&&x.subject===subjectId).length)}function difficultyName(level){return ['متوسط','صعب','أصعب'][level]}function getQuizQuestions(subjectId){let level=getQuizAttemptLevel(subjectId),pool=[...(Q[subjectId]||[]),...(EXTRA_Q[subjectId]||[])];for(let i=pool.length-1;i>0;i--){let j=Math.floor(Math.random()*(i+1));[pool[i],pool[j]]=[pool[j],pool[i]]}let base=examType==='monthly'?5:examType==='mid'?8:10;let count=Math.min(base+level*2,pool.length);return pool.slice(0,count)}
let grade=Number(localStorage.getItem('aio_grade')||1),term=Number(localStorage.getItem('aio_term')||1),currentSubject='math',currentUnit=0,attempts=JSON.parse(localStorage.getItem('aio_attempts')||'[]'),doneLessonKeys=JSON.parse(localStorage.getItem('aio_done_keys')||'[]'),doneLessons=doneLessonKeys.length||Number(localStorage.getItem('aio_done_lessons')||0),examType='monthly';
function scrollToId(id){document.getElementById(id)?.scrollIntoView({behavior:'smooth',block:'start'})}function notice(m){alert(m)}
function renderGrades(){document.getElementById('gradeCards').innerHTML=GRADES.map(g=>`<button class="grade ${g.id===grade?'active':''}" onclick="selectGrade(${g.id})"><div class="grade-icon">${g.icon}</div><b>${g.name}</b><small>${g.note}</small></button>`).join('');document.getElementById('selectedGrade').textContent=GRADES.find(x=>x.id===grade).name;document.getElementById('examGrade').textContent=GRADES.find(x=>x.id===grade).name}
function selectGrade(g){grade=g;localStorage.setItem('aio_grade',g);currentSubject='math';currentUnit=0;renderGrades();renderSubjects();renderCurriculum();renderExams();renderStats()}
function setTerm(t){term=t;localStorage.setItem('aio_term',t);document.getElementById('term1').classList.toggle('active',t===1);document.getElementById('term2').classList.toggle('active',t===2);document.getElementById('termLabel').textContent=t===1?'الترم الأول':'الترم الثاني';renderCurriculum()}
function renderSubjects(){let q=(document.getElementById('subjectSearch')?.value||'').trim().toLowerCase();let list=SUBJECTS.filter(s=>!q||s.name.toLowerCase().includes(q)||s.desc.toLowerCase().includes(q));document.getElementById('subjectCards').innerHTML=list.length?list.map(s=>`<article class="subject" style="--accent:${s.accent};--tint:${s.tint}"><div class="subject-top"><div class="sub-icon">${s.icon}</div><h3>${s.name}</h3><p>${s.desc}</p></div><button onclick="selectSubject('${s.id}')">فتح المادة ←</button></article>`).join(''):'<div class="empty">لا توجد مادة مطابقة. جرّب كلمة بحث أخرى.</div>'}
function makeUnits(){let names=BASE[grade]?.[currentSubject]||[];return names.map((u,ui)=>{let pool=ui===0?DETAIL[currentSubject]||EXTRA:EXTRA;let count=ui===1?6:5;return{u:u,l:Array.from({length:count},(_,i)=>pool[(ui*2+i)%pool.length])}})}
function selectSubject(id){currentSubject=id;currentUnit=0;renderCurriculum();scrollToId('currTitle')}
function renderCurriculum(){let s=SUBJECTS.find(x=>x.id===currentSubject);document.getElementById('crumb').textContent=`${GRADES.find(x=>x.id===grade).name} ← ${term===1?'الترم الأول':'الترم الثاني'}`;document.getElementById('currTitle').textContent=s?`${s.icon} ${s.name}`:'اختر مادة';document.getElementById('currSubtitle').textContent=`خريطة دراسية منظمة • ${term===1?'الترم الأول':'الترم الثاني'} • ${GRADES.find(x=>x.id===grade).name} • راجعنا المصدر الرسمي قبل النشر العام`;let units=makeUnits();document.getElementById('unitCount').textContent=`${units.length} وحدات`;document.getElementById('units').innerHTML=units.map((u,i)=>`<button class="unit-btn ${i===currentUnit?'active':''}" onclick="selectUnit(${i})"><b>${u.u}</b><br><small>${u.l.length} دروس</small></button>`).join('');let u=units[currentUnit];document.getElementById('lessonList').innerHTML=u.l.map((l,i)=>`<div class="lesson-card"><div class="lesson-num">${i+1}</div><div><strong>${l}</strong><small>شرح • أمثلة • تدريب • تقويم</small></div><button class="go" onclick="openLesson('${String(l).replace(/'/g,"\\'")}')">فتح</button></div>`).join('')}
function selectUnit(i){currentUnit=i;renderCurriculum()}
function openLesson(title){let key=[grade,term,currentSubject,title].join('|');if(!doneLessonKeys.includes(key)){doneLessonKeys.push(key);doneLessons=doneLessonKeys.length;localStorage.setItem('aio_done_keys',JSON.stringify(doneLessonKeys));localStorage.setItem('aio_done_lessons',doneLessons);renderStats()}let detail={ar:'اقرأ الفكرة، استخرج الكلمات المفتاحية، ثم طبّق القاعدة على مثال من إنشائك.',en:'Focus on meaning first, then practise the grammar or vocabulary in a short sentence.',math:'اكتب المعطيات، اختر القانون المناسب، نفّذ الخطوات بترتيب، ثم راجع الناتج.',science:'حدّد المفهوم والسبب والنتيجة، واربطه بتجربة أو موقف من الحياة اليومية.',social:'رتّب الأحداث والمواقع زمنيًا ومكانيًا، واربط كل نتيجة بسبب واضح.'}[currentSubject]||'قسّم الفكرة إلى خطوات صغيرة وراجعها بمثال.';document.getElementById('lessonSheet').innerHTML=`<div class="sheet-head"><div><div class="small">${GRADES.find(x=>x.id===grade).name} • ${term===1?'الترم الأول':'الترم الثاني'}</div><h2>${title}</h2></div><button class="close" onclick="closeModal('lessonModal')">إغلاق</button></div><div class="article"><div class="callout"><b>🎯 أهداف الدرس</b><ul><li>فهم الفكرة الأساسية والمصطلحات.</li><li>ربط الفكرة بأمثلة من الحياة.</li><li>الاستعداد لأسئلة التقييم.</li></ul></div><h3>📖 الشرح</h3><p>${detail} هذا شرح تمهيدي مستقل يساعدك على بناء الفهم، ويمكن تدعيمه لاحقًا بمحتوى رسمي موثّق.</p><h3>💡 مثال تطبيقي</h3><div class="callout">مثال عملي مبسط يترجم الفكرة إلى خطوات، ثم تدريب سريع للتحقق من الفهم.</div><button class="primary" onclick="closeModal('lessonModal');startQuiz('${currentSubject}')">اختبر فهمك الآن</button></div>`;document.getElementById('lessonModal').classList.add('show')}
function renderExams(){let tabs=[['monthly','اختبار شهري'],['mid','منتصف العام'],['final','نهاية العام التجريبية']];document.getElementById('examTabs').innerHTML=tabs.map(t=>`<button class="exam-tab ${examType===t[0]?'active':''}" onclick="examType='${t[0]}';renderExams()">${t[1]}</button>`).join('');document.getElementById('examCards').innerHTML=SUBJECTS.map(s=>`<div class="exam-card"><span>${s.icon}</span><b>${s.name}</b><small>${examType==='monthly'?'20 سؤال • 30 دقيقة':examType==='mid'?'نموذج شامل • محاكاة':'نموذج تجريبي شامل'}</small><button onclick="startQuiz('${s.id}')">ابدأ الاختبار</button></div>`).join('')}
function startQuiz(subjectId){currentSubject=subjectId;let quizLevel=getQuizAttemptLevel(subjectId),quizDifficulty=difficultyName(quizLevel),qs=getQuizQuestions(subjectId),idx=0,ans=Array(qs.length).fill(null),s=SUBJECTS.find(x=>x.id===subjectId);function draw(){let q=qs[idx];document.getElementById('quizSheet').innerHTML=`<div class="sheet-head"><div><div class="small">${GRADES.find(x=>x.id===grade).name} • ${s.name}</div><h2>اختبار ${examType==='mid'?'منتصف العام':examType==='final'?'نهاية العام التجريبية':'شهري'}</h2></div><div style="display:flex;gap:8px;align-items:center"><span class="timer">⏱️ ${30-idx}:00</span><button class="close" onclick="closeModal('quizModal')">خروج</button></div></div><div class="small">المستوى: <b>${quizDifficulty}</b> • السؤال ${idx+1} من ${qs.length}</div><div class="progress" style="margin:9px 0 14px"><div class="bar" style="width:${idx/qs.length*100}%"></div></div><div class="q">${q[0]}</div>${q[1].map((x,j)=>`<button class="choice ${ans[idx]===j?'sel':''}" onclick="window.pick(${j})">${String.fromCharCode(65+j)}) ${x}</button>`).join('')}<div style="display:flex;justify-content:space-between;margin-top:16px"><button class="ghost" onclick="window.prevQ()">السابق</button><button class="primary" onclick="window.nextQ()">${idx===qs.length-1?'إنهاء الاختبار':'التالي'}</button></div>`}window.pick=j=>{ans[idx]=j;draw()};window.prevQ=()=>{if(idx>0){idx--;draw()}};window.nextQ=()=>{if(ans[idx]===null)return alert('اختار إجابة الأول 🙂');if(idx<qs.length-1){idx++;draw()}else finishQuiz(subjectId,ans,qs)};document.getElementById('quizModal').classList.add('show');draw()}
function finishQuiz(subjectId,answers,qs){let level=getQuizAttemptLevel(subjectId),correct=answers.reduce((n,a,i)=>n+(a===qs[i][2]?1:0),0),pct=Math.round(correct/qs.length*100);attempts.push({grade,term,subject:subjectId,pct,difficulty:difficultyName(level),date:new Date().toISOString()});localStorage.setItem('aio_attempts',JSON.stringify(attempts));renderStats();document.getElementById('quizSheet').innerHTML=`<div style="text-align:center;padding:20px"><div style="font-size:56px">🏆</div><h2>خلصت الاختبار</h2><p class="muted">${SUBJECTS.find(x=>x.id===subjectId).name}</p><div class="score">${pct}%</div><p>${correct} من ${qs.length} إجابات صحيحة</p><p class="small">مستوى هذه المحاولة: <b>${difficultyName(level)}</b> • تمت زيادة التحدي تلقائيًا للمحاولة التالية.</p><div class="callout" style="text-align:right">🎯 النتيجة محسوبة من إجاباتك وتم تسجيلها في جهازك داخل الـPrototype.</div><button class="primary" onclick="closeModal('quizModal')">العودة للمنصة</button></div>`}
function renderStats(){let a=attempts.filter(x=>x.grade===grade),avg=a.length?Math.round(a.reduce((n,x)=>n+x.pct,0)/a.length):0;document.getElementById('avgScore').textContent=avg+'%';document.getElementById('attempts').textContent=a.length;document.getElementById('lessonsDone').textContent=doneLessons;if(a.length){let c={};a.forEach(x=>(c[x.subject]??=[]).push(x.pct));let best=Object.entries(c).map(([id,v])=>[id,Math.round(v.reduce((m,x)=>m+x,0)/v.length)]).sort((a,b)=>b[1]-a[1])[0];document.getElementById('bestSubject').textContent=SUBJECTS.find(s=>s.id===best[0]).name}else document.getElementById('bestSubject').textContent='—';document.getElementById('gradeProgress').style.width=Math.min(100,Math.round(a.length*12+doneLessons*2))+'%'}
function populateLangs(){document.getElementById('fromLang').innerHTML=LANGS.map(l=>`<option value="${l.code}">${l.name}</option>`).join('');document.getElementById('toLang').innerHTML=LANGS.map(l=>`<option value="${l.code}">${l.name}</option>`).join('');document.getElementById('fromLang').value='en';document.getElementById('toLang').value='ar'}
function swapLangs(){stopSpeaking();let a=document.getElementById('fromLang'),b=document.getElementById('toLang');[a.value,b.value]=[b.value,a.value];let x=document.getElementById('fromText').value;document.getElementById('fromText').value=document.getElementById('toText').value;document.getElementById('toText').value=x;document.getElementById('speakBtn').disabled=!document.getElementById('toText').value.trim()}
async function translateNow(){let text=document.getElementById('fromText').value.trim(),from=document.getElementById('fromLang').value,to=document.getElementById('toLang').value,res=document.getElementById('translationResult');if(!text)return notice('اكتب النص الأول 🙂');res.style.display='block';res.textContent='⏳ جاري الترجمة…';try{let r=await fetch(`https://api.mymemory.translated.net/get?q=${encodeURIComponent(text)}&langpair=${from}|${to}`);let d=await r.json();let out=d?.responseData?.translatedText;if(!out)throw 0;document.getElementById('toText').value=out;document.getElementById('speakBtn').disabled=false;res.textContent='✅ تمت الترجمة عبر خدمة الترجمة الخارجية.';let h=document.getElementById('translationHistory'),chip=document.createElement('button');chip.textContent=text.slice(0,28);chip.onclick=()=>{document.getElementById('fromText').value=text;document.getElementById('toText').value=out};h.prepend(chip)}catch(e){res.textContent='⚠️ تعذر الاتصال بخدمة الترجمة الآن. جرّب مرة أخرى.'}}
function speakTranslation(){let text=document.getElementById('toText').value.trim(),lang=document.getElementById('toLang').value;if(!text)return notice('لا توجد ترجمة لسماعها بعد.');if(!('speechSynthesis' in window))return notice('المتصفح لا يدعم ميزة النطق الصوتي.');stopSpeaking();let u=new SpeechSynthesisUtterance(text);u.lang=lang==='ar'?'ar-SA':lang==='en'?'en-US':lang==='fr'?'fr-FR':lang==='de'?'de-DE':lang==='es'?'es-ES':lang==='it'?'it-IT':'ru-RU';u.rate=.9;u.onstart=()=>{document.getElementById('speakBtn').disabled=true;document.getElementById('stopSpeakBtn').disabled=false;notice('🔊 جارٍ نطق الترجمة…')};u.onend=u.onerror=()=>{document.getElementById('speakBtn').disabled=false;document.getElementById('stopSpeakBtn').disabled=true};speechSynthesis.speak(u)}function stopSpeaking(){if('speechSynthesis' in window)speechSynthesis.cancel();let a=document.getElementById('speakBtn'),b=document.getElementById('stopSpeakBtn');if(a)a.disabled=!document.getElementById('toText').value.trim();if(b)b.disabled=true}function clearTranslator(){stopSpeaking();document.getElementById('fromText').value='';document.getElementById('toText').value='';document.getElementById('speakBtn').disabled=true;document.getElementById('translationResult').style.display='none'}
function openPaymentModal(){document.getElementById('paymentModal').classList.add('show')}function requestOfficialPayment(){let method=document.querySelector('input[name=paymentMethod]:checked')?.value==='vodafone'?'Vodafone Cash':'Etisalat Cash',box=document.getElementById('paymentStatus');box.style.display='block';box.textContent='ℹ️ تم اختيار '+method+'. الدفع لن يبدأ قبل ربط بوابة دفع رسمية وتفعيل تأكيد العملية تلقائيًا.'}function closeModal(id){document.getElementById(id).classList.remove('show')}document.getElementById('paymentModal').addEventListener('click',e=>{if(e.target.id==='paymentModal')closeModal('paymentModal')});document.getElementById('lessonModal').addEventListener('click',e=>{if(e.target.id==='lessonModal')closeModal('lessonModal')});document.getElementById('quizModal').addEventListener('click',e=>{if(e.target.id==='quizModal')closeModal('quizModal')});
if(localStorage.getItem('aio_theme')==='dark'){document.documentElement.classList.add('dark');document.getElementById('themeBtn').textContent='☀️'}renderGrades();setTerm(term);renderSubjects();selectSubject('math');renderExams();renderStats();populateLangs();document.addEventListener('keydown',e=>{if(e.key==='Escape'){closeModal('paymentModal');closeModal('lessonModal');closeModal('quizModal')}});
</script></body></html>
